{
  "manifest_version": 3,
  "name": "TabRot: The Digital Tab Terrarium & Graveyard",
  "version": "1.0.0",
  "description": "A living digital terrarium where neglected tabs rot in real time, beg for CPR, or get cremated into a searchable graveyard.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open TabRot HUD",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
